{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A portfolio project case study",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "client": { "type": "string" },
        "year": { "type": "string" },
        "challenge": { "type": "string" },
        "solution": { "type": "string" },
        "outcome": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "description", "imageUrl", "createdAt", "updatedAt"]
    },
    "Post": {
      "title": "Post",
      "description": "A blog post",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "readTime": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "excerpt", "content", "category", "imageUrl", "createdAt", "updatedAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "A contact inquiry",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message", "status", "createdAt", "updatedAt"]
    },
    "SiteContent": {
      "title": "Site Content",
      "description": "Dynamic text content for the site",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "content", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "projects": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "All portfolio projects"
    },
    "posts": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "All blog posts"
    },
    "inquiries": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Submitted contact inquiries"
    },
    "siteContent": {
      "schema": { "$ref": "#/entities/SiteContent" },
      "description": "Configurable site content sections"
    }
  }
}
