rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'meetjoshiraru@gmail.com';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'category', 'description', 'imageUrl', 'createdAt', 'updatedAt']) 
        && data.title is string && data.title.size() <= 200
        && data.category is string && data.category.size() <= 100
        && data.description is string && data.description.size() <= 5000
        && data.imageUrl is string && data.imageUrl.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['title', 'excerpt', 'content', 'category', 'imageUrl', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() <= 200
        && data.excerpt is string && data.excerpt.size() <= 1000
        && data.content is string && data.content.size() <= 50000
        && data.category is string && data.category.size() <= 100
        && data.imageUrl is string && data.imageUrl.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.keys().size() == 6
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.message is string && data.message.size() <= 2000
        && data.status is string && data.status.size() <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteContent(data) {
      return data.keys().hasAll(['type', 'content', 'createdAt', 'updatedAt'])
        && data.type is string && data.type.size() <= 100
        && data.content is string && data.content.size() <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(postId) && isValidPost(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(postId) && isValidPost(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /siteContent/{contentId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(contentId) && isValidSiteContent(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(contentId) && isValidSiteContent(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time && incoming().status == 'new';
      allow update: if isAdmin() && isValidId(inquiryId) && isValidInquiry(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }
  }
}
